{
  "name": "ai-media-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Media Studio — protótipo navegável da plataforma que opera o ciclo completo de canais de YouTube feitos com IA.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "node .tools/build_prompts.mjs --check && tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:app": "pnpm build && pnpm build:server",
    "start:local": "node build/server/local/cli.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prompts:build": "node .tools/build_prompts.mjs",
    "prompts:check": "node .tools/build_prompts.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
